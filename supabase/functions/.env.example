# Copy to supabase/functions/.env for local `supabase start` / `functions serve`.
# In production set these with `supabase secrets set NAME=value`.

# mock = no real sends (default). live = send through GoHighLevel.
GHL_MODE=mock
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_EMAIL_FROM=
# Local demo only: mark mock sends as delivered right away.
GHL_MOCK_AUTO_DELIVER=true
# Comma-separated phones/emails the mock client should fail (for testing).
GHL_MOCK_FAIL_FOR=

# Webhook auth: a long random token appended to the GHL webhook URL (?token=),
# and/or GHL's public key (PEM) for marketplace-app RSA signatures.
GHL_WEBHOOK_TOKEN=
GHL_WEBHOOK_PUBLIC_KEY=

# Sent by the cron job that calls portal-dispatch every minute.
PORTAL_CRON_SECRET=

# VEKT agent service integration.
AGENT_WEBHOOK_SECRET=
AGENT_START_URL=
AGENT_INBOUND_URL=
